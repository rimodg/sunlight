#!/bin/bash
set -euo pipefail
trap 'result=$?; printf "\nRECEIPT: watch-service exited %s.\n" "$result" >&2' EXIT
task_python="${SUNLIGHT_WATCH_PYTHON:-}"
task_args=()
while (($#)); do
  if [[ "$1" == "--python" ]]; then
    if (($# < 2)); then printf 'Missing --python path\n' >&2; exit 2; fi
    task_python="$2"; shift 2
  else task_args+=("$1"); shift; fi
done
if [[ -z "$task_python" ]]; then task_python="$(command -v python3.12 || true)"; fi
if [[ -z "$task_python" || ! -x "$task_python" ]]; then
  printf 'Pinned CPython 3.12.14 is required. Supply --python /absolute/path. No fallback.\n' >&2
  exit 2
fi
task_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
"$task_python" -I "$task_root/scripts/watch_service.py" "${task_args[@]}"
